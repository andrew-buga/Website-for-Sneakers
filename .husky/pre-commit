#!/bin/sh
# .husky/pre-commit
# Runs before each git commit
# Prevents commits with TypeScript errors, lint issues, or build failures

. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."
echo ""

# 1. Check TypeScript
echo "⏳ Checking TypeScript..."
npx tsc --noEmit

if [ $? -ne 0 ]; then
  echo "❌ TypeScript compilation failed"
  echo "Fix the errors above and try again"
  exit 1
fi

# 2. Check ESLint with lint-staged
echo "⏳ Running ESLint on staged files..."
npx lint-staged

if [ $? -ne 0 ]; then
  echo "❌ ESLint validation failed"
  echo "Fix the linting errors above and try again"
  exit 1
fi

# 3. Check for merge conflicts
echo "⏳ Checking for merge conflicts..."
git diff --check

if [ $? -ne 0 ]; then
  echo "❌ Merge conflicts detected"
  echo "Resolve conflicts before committing"
  exit 1
fi

echo ""
echo "✅ Pre-commit checks passed"
echo ""
