# Database
# Get your PostgreSQL connection string from your database provider (Neon, Railway, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Authentication
# Generate a random 64-character secret for JWT signing: openssl rand -hex 32
JWT_SECRET=your-random-64-character-secret-key-here

# CSRF Protection
# Generate a random secret for CSRF tokens: openssl rand -hex 32
CSRF_SECRET=your-random-64-character-secret-key-here

# Storage (Vercel Blob)
# Get from Vercel dashboard > Storage > Blob > Create
SNEAKER_WEBSITE_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# Email Service (Resend)
# Get from Resend dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=Streater Store <noreply@your-domain.com>

# Rate Limiting (Upstash Redis) - Optional but recommended
# Get from https://upstash.com/docs/redis/features/rest-api
UPSTASH_REDIS_REST_URL=https://TOKEN_HERE.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXE-TOKEN_HERE

# Google Analytics 4
# Get your Measurement ID from Google Analytics: https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Public URLs (no secrets - these are safe to expose)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI/Third-party APIs
# Get from your API provider
AI_GATEWAY_API_KEY=vck_xxxxxxxxxxxxx
