# Prisma datasource (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sneakers?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email provider (Resend)
RESEND_API_KEY=""

# If you want MySQL instead, set provider = "mysql" in prisma/schema.prisma
# and use DATABASE_URL like:
# mysql://USER:PASSWORD@HOST:3306/DB_NAME
